    "q_manual": {
      "type": "route",
      "rev": 1,
      "route": "manual_review"
    },
    "q_priority": {
      "type": "route",
      "rev": 1,
      "route": "priority"
    },
    "q_escalation": {
      "type": "route",
      "rev": 1,
      "route": "escalation"
    },
    "q_normal": {
      "type": "route",
      "rev": 1,
      "route": "normal"
    }
  }
