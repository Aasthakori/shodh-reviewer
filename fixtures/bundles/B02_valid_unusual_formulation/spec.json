{
  "artifact_id": "routing-spec",
  "version": "2.1",
  "rules": [
    {
      "id": "SP-A",
      "order": 1,
      "implements": [
        "R1"
      ],
      "when": {
        "not": {
          "present": "category"
        }
      },
      "route": "manual_review"
    },
    {
      "id": "SP-B",
      "order": 2,
      "implements": [
        "R2"
      ],
      "when": {
        "not": {
          "field": "urgent",
          "op": "==",
          "value": false
        }
      },
      "route": "priority"
    },
    {
      "id": "SP-C",
      "order": 3,
      "implements": [
        "R3"
      ],
      "when": {
        "not": {
          "field": "wait_minutes",
          "op": "<",
          "value": 0.5,
          "unit": "hours"
        }
      },
      "route": "escalation"
    }
  ],
  "default": {
    "route": "normal",
    "implements": [
      "DEFAULT"
    ]
  }
}
