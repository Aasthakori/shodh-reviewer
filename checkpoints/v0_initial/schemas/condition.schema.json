{
  "$id": "condition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured condition",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "missing"
      ],
      "properties": {
        "missing": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "const"
      ],
      "properties": {
        "const": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "not"
      ],
      "properties": {
        "not": {
          "$ref": "#"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "field",
        "op",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "enum": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">=",
            "in"
          ]
        },
        "value": {},
        "unit": {
          "enum": [
            "seconds",
            "minutes",
            "hours"
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}